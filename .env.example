# Copy to .env and fill in what you use. Every setting is optional. A commented
# line shows the default; uncomment it to change the value.
# How to get each key: docs/sources.md

# Contact email for APIs that ask for one. Unpaywall requires it; Crossref
# answers faster with it.
LITFETCH_EMAIL=

# Where works, files and index.csv go. Must not be inside a git checkout unless
# git ignores it.
# LITFETCH_LIBRARY=~/litfetch-library
# Sources in priority order. Add openaire, annas or libgen to opt in.
# LITFETCH_SOURCES=web,crossref,openalex,unpaywall,openlibrary,arxiv,europepmc,semanticscholar,core,hal,zenodo,worldbank,dspace,unods,cellar
# Works processed in parallel, downloads tried per work and run, file size cap.
# LITFETCH_CONCURRENCY=4
# LITFETCH_MAX_ATTEMPTS=5
# LITFETCH_MAX_MB=600
# Seconds an API call may take.
# LITFETCH_TIMEOUT_S=30
# Extra per-host pacing as host=milliseconds between requests; defaults in src/config.js.
# LITFETCH_PACE=example.org=2000

# Source keys
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
# DSPACE_REPOSITORIES=https://iris.who.int,https://openknowledge.worldbank.org,https://openknowledge.fao.org

# Opt-in shadow libraries; check the law where you live.
ANNAS_KEY=
# The only mirrors the key is sent to, starting with the one that last worked.
# ANNAS_MIRRORS=https://annas-archive.gl,https://annas-archive.pk,https://annas-archive.gd
# Hours until used download credits return; credited links allowed per work and run.
# ANNAS_WINDOW_H=18
# ANNAS_MAX_PER_WORK=2
# IPFS_GATEWAYS=https://ipfs.io,https://dweb.link
# LIBGEN_MIRRORS=https://libgen.li,https://libgen.vg,https://libgen.gl,https://libgen.bz,https://libgen.la

# Model triage of uncertain identity checks. Off while LITFETCH_LLM_MODELS is
# empty; when on, opening pages are sent to the Anthropic API.
ANTHROPIC_API_KEY=
# Models in the order they are asked; "unsure" passes to the next.
# LITFETCH_LLM_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5

# Web UI. The token is required for the Queue button (POST /api/queue).
LITFETCH_UI_TOKEN=
# LITFETCH_UI_HOST=127.0.0.1
# LITFETCH_UI_PORT=3000
