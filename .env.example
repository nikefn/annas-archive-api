# Copy to .env and fill in what you use. Every setting is optional.
# How to get each key: docs/sources.md

# Library and pipeline
# Where works, files and index.csv go (absolute path; default: litfetch-library in your
# home folder). Must not be inside a git checkout unless git ignores it.
LITFETCH_LIBRARY=
# Contact email for APIs that ask for one (Crossref polite pool). Unpaywall requires it.
LITFETCH_EMAIL=
# Sources in priority order. Add openaire, annas, libgen to opt in.
LITFETCH_SOURCES=web,crossref,openalex,unpaywall,arxiv,europepmc,semanticscholar,core,hal,zenodo,worldbank,dspace,unods,cellar
# Works processed in parallel, downloads tried per work and run, file size cap.
LITFETCH_CONCURRENCY=4
LITFETCH_MAX_ATTEMPTS=5
LITFETCH_MAX_MB=600
# API response timeout, and the delay before a work that hit an outage is tried again.
LITFETCH_TIMEOUT_S=30
LITFETCH_OUTAGE_RETRY_H=6
# Extra per-host pacing, host=milliseconds between requests (defaults: src/config.js).
LITFETCH_PACE=

# Source credentials
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
DSPACE_REPOSITORIES=https://iris.who.int,https://openknowledge.worldbank.org,https://openknowledge.fao.org

# Opt-in shadow libraries (check the law where you live)
ANNAS_KEY=
# The only mirrors the key is ever sent to, tried starting with the one that last worked.
ANNAS_MIRRORS=https://annas-archive.gl,https://annas-archive.pk,https://annas-archive.gd
# Hours until used fast-download credits return, and credited links allowed per work and run.
ANNAS_WINDOW_H=18
ANNAS_MAX_PER_WORK=2
IPFS_GATEWAYS=https://ipfs.io,https://dweb.link
LIBGEN_MIRRORS=https://libgen.li,https://libgen.vg,https://libgen.gl,https://libgen.bz,https://libgen.la

# Model triage of uncertain identity checks (opt-in: sends opening pages to the Anthropic API)
ANTHROPIC_API_KEY=
# Tried in order; "unsure" escalates. Leave empty to keep triage off.
LITFETCH_LLM_MODELS=
# e.g. LITFETCH_LLM_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5

# Web UI
LITFETCH_UI_HOST=127.0.0.1
LITFETCH_UI_PORT=3000
# Required for the Queue button (POST /api/queue).
LITFETCH_UI_TOKEN=
