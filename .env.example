# Copy to .env and fill in what you use. Every setting is optional unless noted.
# How to obtain each key: docs/sources.md

# --- Library and pipeline -------------------------------------------------
# Where works, files and index.csv are stored.
LITFETCH_LIBRARY=library
# Contact email sent to APIs that ask for one (Crossref, OpenAlex polite pool).
# Required for Unpaywall.
LITFETCH_EMAIL=
# Sources to use, in priority order. Add openaire, annas, libgen to opt in.
LITFETCH_SOURCES=url,crossref,openalex,unpaywall,arxiv,europepmc,semanticscholar,core,hal,zenodo,worldbank,dspace,unods,cellar
# Works processed in parallel; candidate files tried per work; size cap; timeout.
LITFETCH_CONCURRENCY=4
LITFETCH_MAX_ATTEMPTS=5
LITFETCH_MAX_MB=200
LITFETCH_TIMEOUT_S=60

# --- Source credentials ---------------------------------------------------
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
# DSpace 7+ repositories to search (comma-separated base URLs).
DSPACE_REPOSITORIES=https://iris.who.int,https://openknowledge.worldbank.org,https://openknowledge.fao.org

# --- Opt-in shadow libraries (check the law where you live) ---------------
ANNAS_KEY=
ANNAS_BASE_URL=https://annas-archive.gd
LIBGEN_MIRRORS=https://libgen.li,https://libgen.vg,https://libgen.gl,https://libgen.bz,https://libgen.la

# --- Optional model triage of uncertain identity checks -------------------
ANTHROPIC_API_KEY=
# Tried in order; an "unsure" answer escalates to the next model.
LITFETCH_LLM_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
