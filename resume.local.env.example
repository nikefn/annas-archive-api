# Copy to resume.local.env (git-ignored) and adjust. Never put your key here.
BOOKMARKS="$HOME/Desktop/bookmarks.html"   # browser bookmark export
DOWNLOAD_DIR="$HOME/Books"                 # where the scheduler downloads to
SLOTS="17:00 00:00"                         # batch start times (local), space-separated
EVERY=18                                    # hours between repeats of each slot
TLD=""                                      # mirror TLD, e.g. "gd"; empty = default
